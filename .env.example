# Database
DATABASE_URL=postgresql://life_user:life_password_dev@localhost:5432/life_game
REDIS_URL=redis://localhost:6379

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# Backend
PORT=3001
NODE_ENV=development
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRE=7d

# 3D Assets
NEXT_PUBLIC_SKETCHFAB_API_KEY=your_sketchfab_key
READY_PLAYER_ME_API_KEY=your_rpm_key

# Payment
STRIPE_PUBLIC_KEY=your_stripe_public_key
STRIPE_SECRET_KEY=your_stripe_secret_key

# Storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_S3_BUCKET=life-game-assets

# Email
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@lagosgamelife.com

# Analytics
GOOGLE_ANALYTICS_ID=your_ga_id

# Social Auth (optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
